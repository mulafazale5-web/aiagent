# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# In AI Studio, configure via Settings > Secrets.
# On Netlify, add GEMINI_API_KEY in Site configuration > Environment variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional public site URL (automatically provided in Cloud Run / Netlify).
APP_URL="MY_APP_URL"
